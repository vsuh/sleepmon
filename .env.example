# Пароль/PIN-код для входа в веб-приложение
APP_PIN=1234

# Настройки Obsidian Local REST API
# Внутренний URL для доступа между контейнерами (не менять, если используете стандартный docker-compose.yml)
OBSIDIAN_BASE_URL=https://obsidian:27124
# API ключ, который вы получите после настройки плагина Local REST API в Obsidian
OBSIDIAN_API_KEY=your_local_rest_api_key_here

